<!DOCTYPE html>

<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mouvements Artistiques</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=Spectral+SC:wght@400;600&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
<style>
:root {
  --cream: #f5f0e8;
  --warm: #ede8dd;
  --ink: #1a1714;
  --ink2: #3a3530;
  --muted: #8a8278;
  --border: #d4cec4;
  --accent: #8b3a1a;
  --accent2: #1a4a6b;
  --gold: #b8902a;
  --surface: #faf7f2;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
font-family: ‘Cormorant Garamond’, serif;
background: var(–cream);
color: var(–ink);
min-height: 100vh;
}

/* HEADER */
header {
background: var(–ink);
color: var(–cream);
padding: 22px 28px 18px;
display: flex;
align-items: baseline;
gap: 20px;
flex-wrap: wrap;
}
h1 {
font-family: ‘Spectral SC’, serif;
font-size: 1.4rem;
font-weight: 600;
letter-spacing: 0.06em;
color: var(–cream);
}
.header-sub {
font-size: 0.75rem;
color: #9a9288;
font-family: ‘DM Mono’, monospace;
letter-spacing: 0.04em;
}
.header-score {
margin-left: auto;
font-family: ‘DM Mono’, monospace;
font-size: 0.7rem;
color: var(–gold);
letter-spacing: 0.06em;
}

/* TABS */
.tabs {
background: var(–ink2);
display: flex;
padding: 0 28px;
gap: 0;
}
.tab {
padding: 11px 18px;
font-family: ‘DM Mono’, monospace;
font-size: 0.65rem;
letter-spacing: 0.1em;
text-transform: uppercase;
cursor: pointer;
border: none;
background: none;
color: #7a7268;
border-bottom: 2px solid transparent;
transition: all 0.2s;
}
.tab.active { color: var(–gold); border-bottom-color: var(–gold); }
.tab:hover { color: var(–cream); }

/* PERIOD FILTER */
.period-bar {
background: var(–warm);
border-bottom: 1px solid var(–border);
padding: 10px 28px;
display: flex;
gap: 8px;
overflow-x: auto;
scrollbar-width: none;
}
.period-btn {
padding: 5px 13px;
border: 1px solid var(–border);
background: transparent;
color: var(–muted);
font-family: ‘DM Mono’, monospace;
font-size: 0.6rem;
letter-spacing: 0.08em;
cursor: pointer;
white-space: nowrap;
transition: all 0.15s;
border-radius: 1px;
}
.period-btn.active {
background: var(–ink);
color: var(–gold);
border-color: var(–ink);
}

/* MAIN */
main {
padding: 28px;
max-width: 720px;
margin: 0 auto;
}

/* TIMELINE VIEW */
.timeline {
position: relative;
padding-left: 30px;
}
.timeline::before {
content: ‘’;
position: absolute;
left: 8px;
top: 0; bottom: 0;
width: 1px;
background: var(–border);
}
.tl-item {
position: relative;
margin-bottom: 32px;
cursor: pointer;
transition: transform 0.15s;
}
.tl-item:hover { transform: translateX(4px); }
.tl-dot {
position: absolute;
left: -26px;
top: 6px;
width: 10px;
height: 10px;
border-radius: 50%;
border: 2px solid var(–ink);
background: var(–cream);
transition: background 0.15s;
}
.tl-item:hover .tl-dot { background: var(–gold); border-color: var(–gold); }
.tl-period {
font-family: ‘DM Mono’, monospace;
font-size: 0.6rem;
color: var(–accent);
letter-spacing: 0.1em;
margin-bottom: 3px;
}
.tl-name {
font-family: ‘Spectral SC’, serif;
font-size: 1.05rem;
font-weight: 600;
margin-bottom: 5px;
}
.tl-desc {
font-size: 0.85rem;
color: var(–ink2);
line-height: 1.5;
font-style: italic;
margin-bottom: 7px;
}
.tl-painters {
display: flex;
flex-wrap: wrap;
gap: 6px;
}
.painter-chip {
font-family: ‘DM Mono’, monospace;
font-size: 0.58rem;
padding: 3px 8px;
border: 1px solid var(–border);
color: var(–ink2);
letter-spacing: 0.04em;
background: var(–surface);
}

/* FLASHCARD */
.card-wrap {
perspective: 1200px;
margin-bottom: 22px;
}
.card {
position: relative;
width: 100%;
min-height: 260px;
transform-style: preserve-3d;
transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
cursor: pointer;
}
.card.flipped { transform: rotateY(180deg); }
.card-face {
position: absolute;
inset: 0;
min-height: 260px;
backface-visibility: hidden;
-webkit-backface-visibility: hidden;
border: 1px solid var(–border);
padding: 28px;
display: flex;
flex-direction: column;
justify-content: center;
background: var(–surface);
}
.card-back {
transform: rotateY(180deg);
background: var(–ink);
color: var(–cream);
border-color: var(–ink);
}
.card-label {
font-family: ‘DM Mono’, monospace;
font-size: 0.58rem;
letter-spacing: 0.14em;
text-transform: uppercase;
color: var(–muted);
margin-bottom: 10px;
}
.card-back .card-label { color: #7a7268; }
.card-move {
font-family: ‘Spectral SC’, serif;
font-size: 1.6rem;
font-weight: 600;
margin-bottom: 6px;
letter-spacing: 0.02em;
}
.card-period {
font-family: ‘DM Mono’, monospace;
font-size: 0.7rem;
color: var(–gold);
margin-bottom: 12px;
letter-spacing: 0.06em;
}
.card-trait {
font-size: 0.9rem;
font-style: italic;
color: var(–ink2);
line-height: 1.55;
margin-bottom: 14px;
}
.card-back .card-trait { color: #c8c2b8; }
.card-hint {
font-family: ‘DM Mono’, monospace;
font-size: 0.58rem;
color: var(–muted);
margin-top: 10px;
}

.painters-list { list-style: none; }
.painters-list li {
padding: 7px 0;
border-bottom: 1px solid #2e2a26;
display: flex;
justify-content: space-between;
align-items: baseline;
gap: 12px;
}
.painters-list li:last-child { border-bottom: none; }
.painter-name { font-size: 0.95rem; font-weight: 400; }
.painter-dates {
font-family: ‘DM Mono’, monospace;
font-size: 0.62rem;
color: var(–gold);
white-space: nowrap;
}
.painter-work {
font-size: 0.72rem;
font-style: italic;
color: #9a9288;
white-space: nowrap;
overflow: hidden;
text-overflow: ellipsis;
max-width: 160px;
}

/* NAV */
.card-nav {
display: flex;
align-items: center;
justify-content: space-between;
gap: 10px;
margin-bottom: 18px;
}
.nav-btn {
flex: 1;
padding: 10px 14px;
background: var(–surface);
border: 1px solid var(–border);
color: var(–ink);
font-family: ‘DM Mono’, monospace;
font-size: 0.65rem;
letter-spacing: 0.06em;
cursor: pointer;
transition: all 0.15s;
}
.nav-btn:hover { background: var(–ink); color: var(–gold); border-color: var(–ink); }
.counter {
font-family: ‘DM Mono’, monospace;
font-size: 0.65rem;
color: var(–muted);
white-space: nowrap;
text-align: center;
min-width: 56px;
}

/* QUIZ */
.quiz-q {
background: var(–surface);
border: 1px solid var(–border);
padding: 28px 24px 22px;
text-align: center;
margin-bottom: 18px;
}
.quiz-move {
font-family: ‘Spectral SC’, serif;
font-size: 1.5rem;
font-weight: 600;
margin-bottom: 6px;
}
.quiz-prompt {
font-family: ‘DM Mono’, monospace;
font-size: 0.62rem;
color: var(–muted);
letter-spacing: 0.1em;
text-transform: uppercase;
}
.quiz-prompt em { color: var(–accent); font-style: normal; }

.opts {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 9px;
margin-bottom: 16px;
}
@media (max-width: 480px) { .opts { grid-template-columns: 1fr; } }

.opt {
padding: 14px 12px;
background: var(–surface);
border: 1px solid var(–border);
color: var(–ink);
font-family: ‘Cormorant Garamond’, serif;
font-size: 0.95rem;
cursor: pointer;
transition: all 0.15s;
text-align: left;
line-height: 1.3;
}
.opt:hover:not(:disabled) { border-color: var(–accent2); color: var(–accent2); background: #f0f4f8; }
.opt.correct { border-color: #2a6b3a; color: #2a6b3a; background: #f0f8f2; }
.opt.wrong { border-color: var(–accent); color: var(–accent); background: #fdf0ec; }
.opt:disabled { cursor: default; }

.feedback {
font-family: ‘DM Mono’, monospace;
font-size: 0.7rem;
padding: 10px 14px;
border: 1px solid;
margin-bottom: 14px;
display: none;
letter-spacing: 0.04em;
}
.feedback.show { display: block; }
.feedback.correct { border-color: #2a6b3a; color: #2a6b3a; background: #f0f8f2; }
.feedback.wrong { border-color: var(–accent); color: var(–accent); background: #fdf0ec; }

/* STATS */
.stats-row {
display: flex;
gap: 10px;
margin-bottom: 22px;
}
.stat {
flex: 1;
background: var(–surface);
border: 1px solid var(–border);
padding: 14px 10px;
text-align: center;
}
.stat-n {
font-family: ‘Spectral SC’, serif;
font-size: 1.5rem;
margin-bottom: 4px;
line-height: 1;
}
.stat-l {
font-family: ‘DM Mono’, monospace;
font-size: 0.55rem;
color: var(–muted);
letter-spacing: 0.1em;
text-transform: uppercase;
}

.section-hd {
font-family: ‘DM Mono’, monospace;
font-size: 0.58rem;
color: var(–muted);
letter-spacing: 0.14em;
text-transform: uppercase;
margin-bottom: 14px;
padding-bottom: 8px;
border-bottom: 1px solid var(–border);
}
</style>

</head>

const CATS = ["Tous", "Ancien", "Classique", "Moderne", "Contemporain"];
let currentTab = 'flash';
let currentCat = 'Tous';
let flashIndex = 0;
let isFlipped = false;
let shuffled = [];
let quizScore = 0;
let quizTotal = 0;
let currentQuiz = null;

function getFiltered() {
  if (currentCat === 'Tous') return MOVEMENTS;
  return MOVEMENTS.filter(m => m.cat === currentCat);
}

function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function setTab(t) {
  currentTab = t;
  document.querySelectorAll('.tab').forEach((b, i) => {
    b.classList.toggle('active', ['flash', 'quiz', 'timeline'][i] === t);
  });
  if (t === 'flash') { shuffled = shuffle(getFiltered()); flashIndex = 0; isFlipped = false; renderFlash(); }
  else if (t === 'quiz') { quizScore = 0; quizTotal = 0; initQuiz(); }
  else renderTimeline();
}

function setCat(c) {
  currentCat = c;
  document.querySelectorAll('.period-btn').forEach(b => b.classList.toggle('active', b.dataset.c === c));
  shuffled = shuffle(getFiltered()); flashIndex = 0; isFlipped = false;
  quizScore = 0; quizTotal = 0;
  if (currentTab === 'flash') renderFlash();
  else if (currentTab === 'quiz') initQuiz();
  else renderTimeline();
}

// FLASH
function renderFlash() {
  const list = shuffled.length > 0 ? shuffled : shuffle(getFiltered());
  if (!list.length) { document.getElementById('mainContent').innerHTML = '<p style="color:var(--muted); font-family:DM Mono; font-size:.75rem; padding:30px 0">Aucun mouvement.</p>'; return; }
  if (flashIndex >= list.length) flashIndex = 0;
  const m = list[flashIndex];
  shuffled = list;

  document.getElementById('mainContent').innerHTML = `
    <div class="stats-row">
      <div class="stat"><div class="stat-n" style="color:var(--gold)">${flashIndex + 1}</div><div class="stat-l">Position</div></div>
      <div class="stat"><div class="stat-n">${list.length}</div><div class="stat-l">Total</div></div>
      <div class="stat"><div class="stat-n" style="color:var(--accent2)">${m.painters.length}</div><div class="stat-l">Peintres</div></div>
    </div>
    <div class="card-wrap">
      <div class="card ${isFlipped ? 'flipped' : ''}" id="fc" onclick="flip()">
        <div class="card-face">
          <div class="card-label">Mouvement — ${m.era}</div>
          <div class="card-move">${m.name}</div>
          <div class="card-period">${m.period}</div>
          <div class="card-trait">${m.traits}</div>
          <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px">
            ${m.painters.slice(0,3).map(p => `<span class="painter-chip">${p.name.split(' ').pop()}</span>`).join('')}
            ${m.painters.length > 3 ? `<span class="painter-chip">+${m.painters.length-3}</span>` : ''}
          </div>
          <div class="card-hint">→ Cliquer pour voir tous les peintres</div>
        </div>
        <div class="card-face card-back">
          <div class="card-label" style="color:#7a7268">Peintres principaux · ${m.name}</div>
          <ul class="painters-list">
            ${m.painters.map(p => `
              <li>
                <span class="painter-name">${p.name}</span>
                <span class="painter-dates">${p.dates}</span>
                <span class="painter-work">${p.work}</span>
              </li>
            `).join('')}
          </ul>
        </div>
      </div>
    </div>
    <div class="card-nav">
      <button class="nav-btn" onclick="prev()">← Précédent</button>
      <span class="counter">${flashIndex + 1} / ${list.length}</span>
      <button class="nav-btn" onclick="next()">Suivant →</button>
    </div>
    <button class="nav-btn" onclick="doShuffle()" style="width:100%;margin-top:4px">↺ Mélanger</button>
  `;
}

function flip() { isFlipped = !isFlipped; const c = document.getElementById('fc'); if(c) c.classList.toggle('flipped', isFlipped); }
function next() { flashIndex = (flashIndex + 1) % shuffled.length; isFlipped = false; renderFlash(); }
function prev() { flashIndex = (flashIndex - 1 + shuffled.length) % shuffled.length; isFlipped = false; renderFlash(); }
function doShuffle() { shuffled = shuffle(getFiltered()); flashIndex = 0; isFlipped = false; renderFlash(); }

// QUIZ - 3 modes : nom mouvement → period / painter → mouvement / mouvement → peintre
function buildQuiz() {
  const list = getFiltered();
  if (list.length < 4) return null;
  const correct = list[Math.floor(Math.random() * list.length)];
  const wrongs = shuffle(list.filter(m => m.id !== correct.id)).slice(0, 3);
  const mode = Math.floor(Math.random() * 3);
  return { correct, wrongs, opts: shuffle([correct, ...wrongs]), mode, answered: false };
}

function initQuiz() {
  currentQuiz = buildQuiz();
  renderQuiz();
}

function renderQuiz() {
  const q = currentQuiz;
  if (!q) { document.getElementById('mainContent').innerHTML = '<p style="color:var(--muted);font-family:DM Mono;font-size:.75rem;padding:30px 0">Pas assez de mouvements pour ce quiz.</p>'; return; }

  let questionHtml, optionLabel, correctLabel;
  if (q.mode === 0) {
    // nom → période
    questionHtml = `<div class="quiz-move">${q.correct.name}</div><div class="quiz-prompt">Quelle est la <em>période</em> de ce mouvement ?</div>`;
    optionLabel = m => m.period;
    correctLabel = q.correct.period;
  } else if (q.mode === 1) {
    // peintre → mouvement
    const painter = q.correct.painters[Math.floor(Math.random() * q.correct.painters.length)];
    questionHtml = `<div class="quiz-move" style="font-size:1.2rem">${painter.name}</div><div class="quiz-prompt" style="margin-top:4px;font-size:.55rem">${painter.dates}</div><div class="quiz-prompt" style="margin-top:8px">À quel <em>mouvement</em> appartient ce peintre ?</div>`;
    optionLabel = m => m.name;
    correctLabel = q.correct.name;
  } else {
    // mouvement → une œuvre maîtresse
    const painter = q.correct.painters[Math.floor(Math.random() * q.correct.painters.length)];
    questionHtml = `<div class="quiz-move">${q.correct.name}</div><div class="quiz-prompt">Quelle est la <em>période</em> de ce mouvement ?</div>`;
    optionLabel = m => m.period;
    correctLabel = q.correct.period;
  }

  document.getElementById('mainContent').innerHTML = `
    <div class="stats-row">
      <div class="stat"><div class="stat-n" style="color:#2a6b3a">${quizScore}</div><div class="stat-l">Corrects</div></div>
      <div class="stat"><div class="stat-n">${quizTotal}</div><div class="stat-l">Total</div></div>
      <div class="stat"><div class="stat-n" style="color:var(--gold)">${quizTotal > 0 ? Math.round(quizScore/quizTotal*100) : 0}%</div><div class="stat-l">Score</div></div>
    </div>
    <div class="quiz-q">${questionHtml}</div>
    <div class="feedback" id="fb"></div>
    <div class="opts" id="opts">
      ${q.opts.map(m => {
        const lbl = optionLabel(m);
        return `<button class="opt" onclick="answer(this,'${lbl.replace(/'/g,"\\'")}','${correctLabel.replace(/'/g,"\\'")}','${q.correct.name}')">${lbl}</button>`;
      }).join('')}
    </div>
    <button class="nav-btn" id="nxtBtn" onclick="nextQuiz()" style="width:100%;display:none;margin-top:4px">Question suivante →</button>
  `;
}

function answer(btn, chosen, correct, moveName) {
  if (currentQuiz.answered) return;
  currentQuiz.answered = true;
  quizTotal++;
  const ok = chosen === correct;
  if (ok) quizScore++;
  document.querySelectorAll('.opt').forEach(b => {
    b.disabled = true;
    if (b.textContent.trim() === correct) b.classList.add('correct');
    else if (b === btn && !ok) b.classList.add('wrong');
  });
  const fb = document.getElementById('fb');
  fb.className = 'feedback show ' + (ok ? 'correct' : 'wrong');
  fb.textContent = ok ? `✓ Correct — ${moveName} : ${correct}` : `✗ Faux. Réponse : ${correct}`;
  document.getElementById('nxtBtn').style.display = 'block';
  document.querySelectorAll('.stat-n')[0].textContent = quizScore;
  document.querySelectorAll('.stat-n')[1].textContent = quizTotal;
  document.querySelectorAll('.stat-n')[2].textContent = Math.round(quizScore/quizTotal*100) + '%';
}

function nextQuiz() { currentQuiz = buildQuiz(); renderQuiz(); }

// TIMELINE
function renderTimeline() {
  const list = getFiltered();
  document.getElementById('mainContent').innerHTML = `
    <div class="section-hd">${list.length} mouvements · Ordre chronologique</div>
    <div class="timeline">
      ${list.map(m => `
        <div class="tl-item">
          <div class="tl-dot"></div>
          <div class="tl-period">${m.period} — ${m.era}</div>
          <div class="tl-name">${m.name}</div>
          <div class="tl-desc">${m.description}</div>
          <div class="tl-painters">
            ${m.painters.map(p => `<span class="painter-chip">${p.name} <span style="color:var(--muted)">${p.dates}</span></span>`).join('')}
          </div>
        </div>
      `).join('')}
    </div>
  `;
}

// INIT
function init() {
  const bar = document.getElementById('periodBar');
  bar.innerHTML = CATS.map(c => `<button class="period-btn ${c === currentCat ? 'active' : ''}" data-c="${c}" onclick="setCat('${c}')">${c}</button>`).join('');
  document.getElementById('headerScore').textContent = `${MOVEMENTS.length} mouvements`;
  shuffled = shuffle(MOVEMENTS);
  renderFlash();
}

init();
</script>

